# ─── Ollama ───
# Without Docker: http://localhost:11434
# With Docker:    http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=qwen2.5-coder:32b

# ─── Server ───
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ─── Security ───
# Auto-generated on first start if left as default
SECRET_KEY=change-me-in-production-use-a-random-string
RELAY_RATE_LIMIT=30

# ─── Session ───
SESSION_TIMEOUT_MINUTES=120

# ─── TLS ───
ENABLE_TLS=true

# ─── Scanner ───
DEFAULT_RATE_LIMIT=0.2
MAX_FILE_SIZE_MB=2
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ─── Crawler ───
ENABLE_CRAWL=true
MAX_CRAWL_PAGES=20
# auto = detect SPA automatically, true = always render, false = never
# Requires: pip install playwright && playwright install chromium
ENABLE_RENDERER=auto

# ─── Request limits ───
MAX_REQUEST_BODY_MB=10

# ─── Database ───
# Without Docker: scanner.db
# With Docker:    /app/data/scanner.db
DB_PATH=scanner.db

# ─── Notifications (leave empty if not used) ───
WEBHOOK_URL=
SLACK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SENDER=
SMTP_PASSWORD=
SMTP_RECIPIENT=
